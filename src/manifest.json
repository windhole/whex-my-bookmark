{
  "manifest_version": 3,
  "name": "My Bookmark",
  "version": "0.1.0",
  "description": "Save the current page to inbox; browse an imported Markdown library.",
  "permissions": ["storage", "contextMenus", "tabs", "notifications"],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "action": {
    "default_title": "Save current page to inbox",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png"
    }
  },
  "options_page": "src/options/index.html",
  "commands": {
    "_execute_action": {
      "description": "Save current page to inbox"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  }
}
